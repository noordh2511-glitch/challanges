{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomCode": {
        ".write": "auth != null && data.child('meta/ownerUid').val() === auth.uid && !newData.exists()",
        "meta": {
          ".read": "auth != null && data.child('ownerUid').val() === auth.uid",
          ".write": "auth != null && ((!data.exists() && newData.child('ownerUid').val() === auth.uid && newData.child('hostToken').isString() && newData.child('hostToken').val().length >= 16) || (data.exists() && data.child('ownerUid').val() === auth.uid))"
        },
        "publicState": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($roomCode).child('meta/ownerUid').val() === auth.uid"
        },
        "media": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($roomCode).child('meta/ownerUid').val() === auth.uid"
        },
        "hostPrivate": {
          "$token": {
            ".read": "auth != null && (root.child('rooms').child($roomCode).child('meta/ownerUid').val() === auth.uid || (root.child('rooms').child($roomCode).child('meta/hostToken').exists() && root.child('rooms').child($roomCode).child('meta/hostToken').val() === $token))",
            ".write": "auth != null && root.child('rooms').child($roomCode).child('meta/ownerUid').val() === auth.uid"
          }
        },
        "hostCommands": {
          "$token": {
            ".read": "auth != null && (root.child('rooms').child($roomCode).child('meta/ownerUid').val() === auth.uid || (root.child('rooms').child($roomCode).child('meta/hostToken').exists() && root.child('rooms').child($roomCode).child('meta/hostToken').val() === $token))",
            ".write": "auth != null && (root.child('rooms').child($roomCode).child('meta/ownerUid').val() === auth.uid || (root.child('rooms').child($roomCode).child('meta/hostToken').exists() && root.child('rooms').child($roomCode).child('meta/hostToken').val() === $token))",
            "$cmdId": {
              ".validate": "!newData.exists() || (newData.hasChildren(['type', 'sentAt']) && newData.child('type').isString())"
            }
          }
        },
        "allowedDevices": {
          ".write": "auth != null && root.child('rooms').child($roomCode).child('meta/ownerUid').val() === auth.uid",
          "$deviceId": {
            ".read": "auth != null"
          }
        },
        "kicked": {
          ".write": "auth != null && root.child('rooms').child($roomCode).child('meta/ownerUid').val() === auth.uid",
          "$deviceId": {
            ".read": "auth != null",
            ".write": "auth != null && root.child('rooms').child($roomCode).child('meta/ownerUid').val() === auth.uid"
          }
        },
        "buzzes": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($roomCode).child('meta/ownerUid').val() === auth.uid",
          "$buzzRoundId": {
            "$teamKey": {
              ".write": "auth != null && (!data.exists() || root.child('rooms').child($roomCode).child('meta/ownerUid').val() === auth.uid) && (!newData.exists() || root.child('rooms').child($roomCode).child('meta/ownerUid').val() === auth.uid || (newData.child('deviceId').isString() && !root.child('rooms').child($roomCode).child('kicked').child(newData.child('deviceId').val()).exists()))",
              ".validate": "!newData.exists() || (newData.hasChildren(['teamIdx', 'teamName', 'deviceId', 'ts']) && newData.child('teamIdx').isNumber() && newData.child('teamName').isString() && newData.child('teamName').val().length <= 40 && newData.child('deviceId').isString())"
            }
          }
        },
        "wagers": {
          ".read": "auth != null && root.child('rooms').child($roomCode).child('meta/ownerUid').val() === auth.uid",
          ".write": "auth != null && root.child('rooms').child($roomCode).child('meta/ownerUid').val() === auth.uid",
          "$roundId": {
            "$teamId": {
              ".write": "auth != null && root.child('rooms').child($roomCode).child('meta').exists() && (!newData.exists() || root.child('rooms').child($roomCode).child('meta/ownerUid').val() === auth.uid || (newData.child('deviceId').isString() && !root.child('rooms').child($roomCode).child('kicked').child(newData.child('deviceId').val()).exists()))",
              ".validate": "!newData.exists() || (newData.hasChildren(['teamIdx', 'amount', 'locked', 'deviceId', 'updatedAt']) && newData.child('teamIdx').isNumber() && newData.child('amount').isNumber() && newData.child('amount').val() >= 0 && newData.child('deviceId').isString() && (!newData.child('answerText').exists() || (newData.child('answerText').isString() && newData.child('answerText').val().length <= 160)))"
            }
          }
        },
        "players": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($roomCode).child('meta/ownerUid').val() === auth.uid",
          "$deviceId": {
            ".write": "auth != null && (root.child('rooms').child($roomCode).child('meta/ownerUid').val() === auth.uid || (!newData.exists() && (!data.exists() || data.child('uid').val() === auth.uid)) || (!root.child('rooms').child($roomCode).child('kicked').child($deviceId).exists() && newData.child('uid').val() === auth.uid && (!data.exists() || data.child('uid').val() === auth.uid) && (data.exists() || root.child('rooms').child($roomCode).child('meta/joinLocked').val() !== true || root.child('rooms').child($roomCode).child('allowedDevices').child($deviceId).exists())))",
            ".validate": "!newData.exists() || (newData.hasChildren(['deviceId', 'uid', 'teamId', 'teamIdx', 'label']) && newData.child('deviceId').isString() && newData.child('deviceId').val() === $deviceId && newData.child('uid').val() === auth.uid && newData.child('teamId').isString() && newData.child('teamIdx').isNumber() && newData.child('label').isString() && newData.child('label').val().length <= 32)"
          }
        }
      }
    },
    "baraRooms": {
      ".read": false,
      ".write": false,
      "$roomCode": {
        ".write": "auth != null && data.child('meta/ownerUid').val() === auth.uid && !newData.exists()",
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && ((!data.exists() && newData.child('ownerUid').val() === auth.uid) || (data.exists() && data.child('ownerUid').val() === auth.uid))"
        },
        "publicState": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('baraRooms').child($roomCode).child('meta/ownerUid').val() === auth.uid"
        },
        "allowedPlayers": {
          ".write": "auth != null && root.child('baraRooms').child($roomCode).child('meta/ownerUid').val() === auth.uid",
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || root.child('baraRooms').child($roomCode).child('meta/ownerUid').val() === auth.uid)"
          }
        },
        "privateRoles": {
          ".write": "auth != null && root.child('baraRooms').child($roomCode).child('meta/ownerUid').val() === auth.uid",
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || root.child('baraRooms').child($roomCode).child('meta/ownerUid').val() === auth.uid)",
            ".write": "auth != null && root.child('baraRooms').child($roomCode).child('meta/ownerUid').val() === auth.uid"
          }
        },
        "playerActions": {
          ".read": "auth != null && root.child('baraRooms').child($roomCode).child('meta/ownerUid').val() === auth.uid",
          ".write": "auth != null && root.child('baraRooms').child($roomCode).child('meta/ownerUid').val() === auth.uid",
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || root.child('baraRooms').child($roomCode).child('meta/ownerUid').val() === auth.uid)",
            ".write": "auth != null && (root.child('baraRooms').child($roomCode).child('meta/ownerUid').val() === auth.uid || (auth.uid === $uid && !root.child('baraRooms').child($roomCode).child('kicked').child($uid).exists()))"
          }
        },
        "players": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('baraRooms').child($roomCode).child('meta/ownerUid').val() === auth.uid",
          "$uid": {
            ".write": "auth != null && (root.child('baraRooms').child($roomCode).child('meta/ownerUid').val() === auth.uid || (!newData.exists() && (!data.exists() || $uid === auth.uid)) || (auth.uid === $uid && !root.child('baraRooms').child($roomCode).child('kicked').child($uid).exists() && (data.exists() || root.child('baraRooms').child($roomCode).child('meta/joinLocked').val() !== true || root.child('baraRooms').child($roomCode).child('allowedPlayers').child($uid).exists())))",
            ".validate": "!newData.exists() || (newData.hasChildren(['uid', 'name']) && newData.child('uid').val() === auth.uid && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 28)"
          }
        },
        "kicked": {
          ".write": "auth != null && root.child('baraRooms').child($roomCode).child('meta/ownerUid').val() === auth.uid",
          "$uid": {
            ".read": "auth != null",
            ".write": "auth != null && root.child('baraRooms').child($roomCode).child('meta/ownerUid').val() === auth.uid"
          }
        }
      }
    }
  }
}
